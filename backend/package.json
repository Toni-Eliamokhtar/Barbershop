    "test:bdd": "cucumber-js --import 'features/step_definitions/**/*.js'",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:bdd",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.js'"
